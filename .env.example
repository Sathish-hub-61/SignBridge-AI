# SignBridge AI — Environment Configuration
# Copy this file to .env and configure your keys.
# NEVER commit your actual .env file or paste API keys into chat.

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# OpenRouter Configuration (Language & Context Layer)
# Format: Bearer sk-or-v1-...
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.2-3b-instruct:free,deepseek/deepseek-chat

# LLM Generation Parameters
LLM_TIMEOUT_S=15.0
LLM_TEMPERATURE_INTERPRET=0.1
LLM_TEMPERATURE_RESPOND=0.7

# Recognizer Engine: 'mock' (default for testing) or 'model'
RECOGNIZER=mock

# Live Integration Tests Flag (0 = disabled, 1 = enabled)
RUN_LIVE_TESTS=0
